// KClass.HC — runtime class reflection. For every class the user defines, the
// compiler synthesizes a CHashClass descriptor plus a CMemberLst chain of its
// members (name, byte offset, byte size, type spelling), and the body of
// Class(name) that returns a class's descriptor. This mirrors TempleOS HolyC's
// class metadata (CHashClass / member_lst_and_root), backed by compiler-emitted
// tables rather than a live symbol table. Nothing is emitted unless the program
// uses Class/ClassRep, so reflection is pay-for-what-you-use. Part of the
// always-resident prelude (see Lib.HC).
#ifndef __PRELUDE_KCLASS_HC
#define __PRELUDE_KCLASS_HC

public class CMemberMeta {
  CMemberMeta *next; // next metadata entry, or NULL
  U8          *key;  // metadata key, e.g. "format" or "data"
  U8          *str;  // string value, or NULL for an integer-valued entry
  I64          val;  // integer value (0 for a string-valued entry)
};

public class CMemberLst {
  CMemberLst  *next;         // next member in the chain, or NULL
  U8          *str;          // member name
  I64          off;          // byte offset within the class (== offset(Class.member))
  I64          size;         // byte size (== sizeof(member type))
  U8          *member_class; // member type spelling, e.g. "I64", "U8*", "CTask*"
  CMemberMeta *meta;         // member metadata chain (format/data/...), or NULL
};

public class CHashClass {
  U8         *str;                 // class name
  I64         size;                // sizeof(class)
  CMemberLst *member_lst_and_root; // first member of the chain, or NULL
};

// Class returns the descriptor for the named class, or NULL if there is none. The
// body is generated by the compiler (one branch per class); this is the forward
// declaration so reflection helpers can call it.
public CHashClass *Class(U8 *name);

// _ReflStrEq reports whether two NUL-terminated strings are equal.
public I64 _ReflStrEq(U8 *a, U8 *b)
{
  I64 i = 0;
  while (a[i] != 0 && a[i] == b[i])
    i++;
  return a[i] == b[i];
}

// MemberMetaFind returns member m's metadata entry for key, or NULL if absent.
public CMemberMeta *MemberMetaFind(CMemberLst *m, U8 *key)
{
  CMemberMeta *e = m->meta;
  while (e != NULL) {
    if (_ReflStrEq(e->key, key))
      return e;
    e = e->next;
  }
  return NULL;
}

// MemberMetaData returns the string value of member m's metadata for key (e.g. a
// "format" string), or NULL if there is no such entry (or it is integer-valued).
public U8 *MemberMetaData(CMemberLst *m, U8 *key)
{
  CMemberMeta *e = MemberMetaFind(m, key);
  if (e)
    return e->str;
  return NULL;
}

// ClassRep walks a class's metadata and prints it: a header line `name size`, then
// one `type name offset size` line per member.
public U0 ClassRep(U8 *name)
{
  CHashClass *c = Class(name);
  if (!c) {
    Print("%s ?\n", name);
    return;
  }
  Print("%s %d\n", c->str, c->size);
  CMemberLst *m = c->member_lst_and_root;
  while (m != NULL) {
    Print("%s %s %d %d\n", m->member_class, m->str, m->off, m->size);
    m = m->next;
  }
}

#endif // __PRELUDE_KCLASS_HC
